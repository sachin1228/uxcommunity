{
  "expo": {
    "name": "uxcommunity",
    "slug": "uxcommunity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-square.png",
    "scheme": "uxcommunity",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/uxcommunity-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sachinpatil1228.myapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "backgroundColor": "#09090B",
      "package": "in.uxcommunity.app",
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-circle.png",
        "backgroundColor": "#1D1F26",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withAndroidAccent",
      "./plugins/withAndroidReleaseSigning",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow uxcommunity to access your photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1D1F26",
          "defaultChannel": "messages"
        }
      ],
      "./plugins/withChatNotifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow uxcommunity to access your photos.",
          "savePhotosPermission": "Allow uxcommunity to save chat images to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo", "video"]
        }
      ],
      "expo-video",
      "expo-secure-store",
      "./plugins/withAndroidBackupPolicy",
      "./plugins/withAndroidPermissionScopes"
    ],
    "notification": {
      "color": "#1D1F26"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be506e75-076e-4d15-9dcc-6c8761117174"
      }
    }
  }
}
