# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase server credentials — NEVER commit these. The FCM v1 service-account
# key belongs in Expo credentials (Android → Push Notifications), not in git.
*firebase-adminsdk*.json
*-adminsdk-*.json
*service-account*.json

# Note: google-services.json is deliberately NOT ignored — it is client config
# (not a secret) and cloud builds need it in the repository.

# typescript
*.tsbuildinfo
.vercel

.env
