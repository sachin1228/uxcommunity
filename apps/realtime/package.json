{
  "name": "@uxcommunity/realtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "test:ws": "vitest run __tests__/ws-ownership.test.ts --reporter=verbose",
    "test:perf": "vitest run __tests__/perf-duplicates.test.ts __tests__/perf-light.test.ts __tests__/perf-latency-burst.test.ts __tests__/perf-hot-communities.test.ts __tests__/perf-large-index.test.ts __tests__/perf-index-benchmark.test.ts __tests__/perf-fanout-final.test.ts __tests__/performance.integration.test.ts --reporter=verbose"
  },
  "dependencies": {
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "miniflare": "^5.20260811.1-alpha",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  }
}
