# ── Transcoder service (apps/transcoder) ─────────────────────────────────────
# Polls video_media rows queued by the web app, encodes with native ffmpeg,
# uploads the canonical MP4 to R2, and completes the job via the web app's
# internal API. Needs ffmpeg + ffprobe on PATH (or FFMPEG_PATH / FFPROBE_PATH)
# and network access to Supabase, R2 and the web app.

# Supabase (service role — same values as the web app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 (same values as the web app)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=draft-images
# Public base used to build canonical URLs (must match the web app)
R2_PUBLIC_URL=https://media.uxcommunity.in

# Internal API auth — MUST match the web app's API_SECRET
API_SECRET=replace-with-the-web-apps-api-secret
# Base URL of the web app (the internal /api/internal/video/complete route)
APP_URL=https://app.uxcommunity.in

# Optional overrides
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# WORKER_ID=transcoder-1            # unique per instance (default: hostname)
# POLL_INTERVAL_MS=5000
# JOB_BATCH_SIZE=2
# CLAIM_LEASE_MS=600000             # how long a claimed job may run
# PROCESS_TIMEOUT_MS=1500000        # hard timeout for one ffmpeg job
# TEMP_DIR=/tmp/transcoder