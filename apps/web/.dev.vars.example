# Copy to `.dev.vars` (gitignored) and fill in real values for local
# `wrangler dev` / `opennextjs-cloudflare preview`.
#
# NEXT_PUBLIC_* vars are inlined into the client at `next build` time, so they
# must ALSO be present in the build environment (e.g. apps/web/.env.production.local).

# --- Public / non-secret (also set in wrangler.toml [vars] for runtime) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_REALTIME_URL=

# --- Realtime (server -> Worker) ---
REALTIME_URL=
REALTIME_PUBLISH_SECRET=

# --- Internal API auth (realtime DO -> web API membership check) ---
API_SECRET=

# --- Auth / secrets (prod: `wrangler secret put <NAME>`) ---
SESSION_SECRET=

# --- Supabase ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash rate limiting ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- GIPHY ---
GIPHY_API_KEY=

# --- R2 (existing uploads bucket; keep values as-is) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Admin bootstrap / misc ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
INVITATION_EXPIRY_DAYS=7

# --- Optional push delivery tuning (leave blank to use the defaults) ---
# Expo accepts at most 100 messages per request and ~600 notifications per
# second per project; see apps/web/lib/push/expo.ts for how each value is used.
PUSH_BATCH_SIZE=
PUSH_MAX_CONCURRENCY=
PUSH_RATE_LIMIT=
PUSH_MAX_RETRIES=
PUSH_RETRY_BASE_MS=
PUSH_RETRY_MAX_MS=
PUSH_REQUEST_TIMEOUT_MS=
PUSH_MAX_DELIVERIES=
PUSH_TIME_BUDGET_MS=