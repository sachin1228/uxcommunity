# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Session ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret

# ── Admin credentials ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@example.com

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of extra origins allowed to call /api/* routes.
# http://localhost:8081 and http://localhost:3000 are always allowed in any env.
# Add your production frontend domain(s) here, e.g.:
# CORS_ALLOWED_ORIGINS=https://myapp.com,https://staging.myapp.com
CORS_ALLOWED_ORIGINS=
