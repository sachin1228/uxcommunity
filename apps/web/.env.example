# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# The anon key may be exposed to the browser; the service-role key must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Custom JWT sessions
# In Replit, keep this in Secrets instead of committing it to a file.
SESSION_SECRET=replace-with-a-long-random-secret

# Built-in admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password

# Transactional email (Resend)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Draft Hub <noreply@example.com>
INVITATION_EXPIRY_DAYS=7

# Upstash Redis rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Cloudflare R2 image storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=draft-images
R2_PUBLIC_URL=https://your-public-r2-domain.example

# Optional GIF/sticker search
GIPHY_API_KEY=your-giphy-api-key

# Optional image moderation service
MODERATION_IMAGE_SERVICE_URL=
MODERATION_IMAGE_MAX_BYTES=20971520
MODERATION_IMAGE_TIMEOUT_MS=8000

# Optional moderation tuning
MODERATION_TEXT_MAX_LENGTH=2000
MODERATION_TEXT_BURST_LIMIT=5
MODERATION_TEXT_MINUTE_LIMIT=20
MODERATION_REJECT_KEYWORDS=
MODERATION_REVIEW_KEYWORDS=
MODERATION_PROFANITY_WORDS=

# Optional load-test defaults
TEST_COMMUNITY_ID=
K6_USER_COUNT=200
K6_USER_PASSWORD=
K6_USER_PREFIX=loadtest