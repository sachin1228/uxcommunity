# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://app.uxcommunity.in/

# Supabase
# The app talks to Supabase only through the server-side service-role client,
# which must remain server-only. There is no anon key: every table is locked
# down so a client role could not read it even if one leaked.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Custom JWT sessions
# In Replit, keep this in Secrets instead of committing it to a file.
SESSION_SECRET=replace-with-a-long-random-secret

# Internal API auth (realtime DO -> web API membership check)
API_SECRET=replace-with-a-long-random-secret

# Built-in admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password

# Transactional email (Resend)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Draft Hub <noreply@example.com>
INVITATION_EXPIRY_DAYS=7

# Upstash Redis rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Cloudflare R2 image storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=draft-images
# MUST be a custom domain attached to the bucket in the Cloudflare dashboard
# (e.g. https://media.uxcommunity.in). The pub-*.r2.dev dev URL works for
# delivery but bypasses the Cloudflare CDN edge cache, so uploads tagged
# `public, max-age=31536000, immutable` would never be edge-cached.
R2_PUBLIC_URL=https://your-public-r2-domain.example
# Optional GIF/sticker search
GIPHY_API_KEY=your-giphy-api-key

# Optional push delivery tuning (defaults shown; see lib/push/expo.ts)
# Expo accepts at most 100 messages per request, so PUSH_BATCH_SIZE is clamped to
# that ceiling. PUSH_RATE_LIMIT defaults to Expo's documented project ceiling of
# 600 notifications/sec, but it bounds ONE invocation: it is local pacing, not a
# project-wide budget, so concurrent fan-outs can exceed 600/s together and rely
# on the 429 + Retry-After retry path. PUSH_MAX_CONCURRENCY mirrors the official
# SDK's six connections.
PUSH_BATCH_SIZE=100
PUSH_MAX_CONCURRENCY=6
PUSH_RATE_LIMIT=600
PUSH_MAX_RETRIES=3
PUSH_RETRY_BASE_MS=500
PUSH_RETRY_MAX_MS=8000
PUSH_REQUEST_TIMEOUT_MS=10000
# Per chat message: ceiling on device pushes, and the wall-clock budget the
# sender may spend on them (it runs in the message route's after() block).
PUSH_MAX_DELIVERIES=10000
PUSH_TIME_BUDGET_MS=20000

# Optional load-test defaults
TEST_COMMUNITY_ID=
K6_USER_COUNT=200
K6_USER_PASSWORD=
K6_USER_PREFIX=loadtest