{
  "name": "uxcommunity",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/extract-emoji.mjs",
    "prebuild": "node scripts/extract-emoji.mjs",
    "emoji:update": "node scripts/update-emoji.mjs",
    "dev": "npm run dev --workspace=apps/web",
    "dev:realtime": "npm run dev --workspace=apps/realtime",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "cloudflare:build": "npm run cloudflare:build --workspace=apps/web",
    "deploy:web": "npm run deploy --workspace=apps/web",
    "deploy:realtime": "wrangler deploy --config apps/realtime/wrangler.toml",
    "lint": "npm run lint --workspace=apps/web",
    "audit:comments": "node scripts/audit-comments.mjs",
    "audit:vercel": "node scripts/audit-vercel.mjs",
    "test:interactions": "tsx --test apps/web/lib/boolean-intent-coalescer.test.ts",
    "test:signup": "tsx --test apps/web/lib/signup-completion.test.ts apps/web/lib/auth/signup-status.test.ts",
    "test:request-cache": "tsx --test apps/web/lib/request-cache.test.ts",
    "test:session-cache": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/session-cache.test.ts",
    "test:password": "tsx --test apps/web/lib/auth/password.test.ts",
    "test:dedupe": "tsx --test apps/web/lib/dedupe-fetch.test.ts apps/web/lib/navigation-guard.test.ts",
    "test:global-fetch": "tsx --test apps/web/lib/global-fetch.test.ts",
    "test:link-preview-cache": "tsx --test apps/web/lib/communities/linkPreviewCache.test.ts",
    "test:mentions": "tsx --test apps/web/lib/communities/mentions.test.ts",
    "test:comment-text": "tsx --test apps/web/lib/communities/comment-text.test.ts",
    "test:preview-text": "tsx --test apps/web/lib/communities/preview-text.test.ts",
    "test:comment-tree": "tsx --test apps/web/lib/communities/comment-tree.test.ts",
    "test:user-color": "tsx --test apps/web/lib/communities/user-color.test.ts",
    "test:r2-lifecycle": "tsx --test apps/web/lib/r2-lifecycle.test.ts",
    "test:content-event-ids": "tsx --test apps/web/lib/communities/content-event-ids.test.ts",
    "test:publish-retry": "tsx --test apps/web/lib/realtime/publish-retry.test.ts apps/web/lib/realtime/publish-url.test.ts",
    "test:observability": "tsx --test apps/web/lib/observability/log.test.ts",
    "test:read-manager": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/read-manager.test.ts",
    "test:sidebar-merge": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/components/communities/panel/sidebar-merge.test.ts",
    "test:sidebar-content": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/components/communities/panel/sidebar-content.test.ts",
    "test:sidebar-order": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/components/communities/panel/sidebar-order.test.ts",
    "test:undo-toast": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/undo-toast.test.ts",
    "test:going-list": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/components/communities/events/going-list.test.ts",
    "test:chat-scroll": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/components/communities/chat/chatUtils.test.ts",
    "test:mention-jumps": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/components/communities/chat/mention-jumps.test.ts",
    "test:notification-tabs": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/notifications-tabs.test.ts",
    "test:notification-realtime": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/notifications-realtime.test.ts",
    "test:companies": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/companies/domains.test.ts apps/web/lib/companies/codes.test.ts apps/web/lib/companies/logos.test.ts",
    "test:companies-db": "bash supabase/tests/run-local.sh supabase/tests/company_verified_domains.test.sql supabase/tests/company_domain_stewardship.test.sql supabase/tests/company_verification_explicit_company.test.sql supabase/tests/company_domain_review.test.sql supabase/tests/company_directory_seed_retirement.test.sql",
    "test:companies-v2": "node --test scripts/generate-company-directory-v2.test.mjs scripts/generate-company-directory-reset.test.mjs",
    "test:companies-import": "node --test scripts/import-company-directory.test.mjs",
    "test:companies-roundtrip": "bash scripts/run-company-directory-scratch.sh scripts/company-directory-roundtrip.test.mjs",
    "test:companies-merge-guards": "bash scripts/run-company-directory-scratch.sh scripts/company-directory-merge-guards.test.mjs",
    "companies:v2": "node scripts/generate-company-directory-v2.mjs",
    "companies:reset:sql": "node scripts/generate-company-directory-reset.mjs",
    "companies:reset:plan": "node scripts/reset-company-directory-seed.mjs",
    "companies:reset": "node scripts/reset-company-directory-seed.mjs --apply",
    "companies:import": "node scripts/import-company-directory.mjs",
    "companies:import:dry": "node scripts/import-company-directory.mjs --dry-run data/company-directory/prototype",
    "bench:companies": "psql -v n=100000 -f scripts/bench-company-search.sql",
    "bench:companies-import": "node scripts/bench-company-directory-import.mjs --n 500000",
    "bench:companies-directory": "bash scripts/bench-company-directory.sh",
    "test:notification-dedupe": "bash supabase/tests/run-local.sh supabase/tests/notification_dedupe.test.sql",
    "test:message-page-reactions": "bash supabase/tests/run-local.sh supabase/tests/message_page_content_reactions.test.sql",
    "test:message-page-rpc": "bash supabase/tests/run-local.sh supabase/tests/message_page_rpc_signature.test.sql",
    "test:community-areas": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/communities/areas.test.ts",
    "test:event-chat": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/communities/event-chat-rules.test.ts",
    "test:event-join-questions": "tsx --test apps/web/lib/communities/event-join-questions.test.ts",
    "test:event-date": "tsx --test apps/web/lib/communities/event-date.test.ts",
    "test:event-time": "tsx --test apps/web/lib/communities/event-time.test.ts",
    "test:event-display": "tsx --test apps/web/lib/communities/event-display.test.ts",
    "test:timezone": "tsx --test apps/web/lib/communities/timezone.test.ts",
    "test:event-timezone": "tsx --test \"expo-app-standalone 3/lib/eventTimezone.test.ts\"",
    "test:mobile-realtime": "tsx --test \"expo-app-standalone 3/lib/realtimeCore.test.ts\" \"expo-app-standalone 3/lib/realtimeCatchUp.test.ts\" \"expo-app-standalone 3/lib/realtimeWindow.test.ts\" \"expo-app-standalone 3/lib/realtimeScale.test.ts\" \"expo-app-standalone 3/lib/realtimeAuth.test.ts\"",
    "test:mobile-cache": "tsx --test \"expo-app-standalone 3/lib/nameCache.test.ts\"",
    "test:home-rail": "tsx --test apps/web/lib/home/suggested.test.ts",
    "test:community-badges": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/communities/community-badges.test.ts",
    "test:community-settings": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/communities/community-settings.test.ts",
    "test:content-sync": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/communities/content-sync.test.ts",
    "test:push-budget": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/push/chat.test.ts",
    "test:push-fanout": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/push/chat-batch.test.ts apps/web/lib/push/expo.test.ts apps/web/lib/push/receipts.test.ts",
    "test:feed-scope": "tsx --test apps/web/lib/feeds/home-feed-options.test.ts",
    "test:topbar": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/dashboard/topbar.test.ts",
    "test:video-upload": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/video/upload-guard.test.ts",
    "test:rpc-integration": "npx supabase test db --file supabase/tests/performance_rpcs.test.sql",
    "test:security": "npx supabase test db --file supabase/tests/public_read_exposure.test.sql",
    "test:member-count": "npx supabase test db --file supabase/tests/member_count.test.sql",
    "k6:seed": "node k6/scripts/seed-users.js",
    "k6:cleanup": "node k6/scripts/cleanup-users.js",
    "test:k6-fixtures": "tsx --test k6/lib/fixture.test.mjs",
    "test:k6-realtime": "tsx --test k6/lib/realtime-fanout.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "lottie-react": "^2.4.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
